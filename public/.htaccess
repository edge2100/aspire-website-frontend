<IfModule mod_rewrite.c>
RewriteEngine On

# Preserve .well-known for SSL verification
RewriteCond %{REQUEST_URI} ^/.well-known/assetlinks.json$
RewriteRule ^ - [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect non-www to www (with HTTPS)
RewriteCond %{HTTP_HOST} ^aspirenow\.in [NC]
RewriteRule ^(.*)$ https://www.aspirenow.in/$1 [L,R=301]
</IfModule>